{
	"name": "prejemesi",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "pnpm run db:start && pnpm run seed:images",
		"dev": "vite dev",
		"dev:agent": "node scripts/run-development-service.mjs agent",
		"build": "vite build",
		"deploy": "vite build && wrangler deploy",
		"preview": "node scripts/run-development-service.mjs preview",
		"paraglide:compile": "node ./scripts/paraglide-compile.mjs",
		"check": "node ./scripts/paraglide-compile.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "pnpm check",
		"check:prepush": "node scripts/pre-push-parallel.js",
		"check:fast": "prettier --write --log-level warn . && oxlint",
		"check:all": "pnpm paraglide:compile && svelte-kit sync && prettier --write . && node scripts/check-all-parallel.mjs",
		"check:fallow": "node scripts/fallow-check.js",
		"check:migrations": "node scripts/check-migration-safety.mjs && pnpm check:migration-history",
		"check:migration-history": "tsx scripts/check-migration-history.ts",
		"check:vykani": "node scripts/check_vykani.mjs",
		"fallow:audit": "fallow audit --format json --quiet --explain",
		"fallow:save-baseline": "fallow dead-code --save-regression-baseline fallow-baselines/dead-code-regression.json",
		"lint": "oxlint",
		"lint:eslint": "eslint .",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --write .",
		"test": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:changed": "playwright test --only-changed=dev",
		"perf:collect": "node scripts/production-performance.mjs collect",
		"perf:compare": "node scripts/production-performance.mjs compare",
		"test:performance-report": "node --test scripts/production-performance.test.mjs",
		"test:scripts": "node --test scripts/*.test.mjs",
		"ingest:gifts": "tsx scripts/ingest-gifts.ts",
		"loadtest": "tsx tests/load/run.ts",
		"loadtest:setup": "tsx tests/load/setup.ts",
		"loadtest:cleanup": "tsx tests/load/cleanup.ts",
		"prepare": "husky",
		"db:start": "docker compose --project-name prejemesi up -d --wait db",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:prod": "tsx scripts/migrate-prod.ts",
		"db:verify:prod": "tsx scripts/migrate-prod.ts --check",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"seed:images": "tsx scripts/prepare-seed-images.ts",
		"db:studio": "drizzle-kit studio",
		"db:audit:crop-rects": "tsx scripts/audit-legacy-crop-rects.ts",
		"cf:types": "wrangler types --no-include-runtime",
		"r2:cors:generate": "tsx scripts/generate-r2-cors.ts",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"storybook": "pnpm paraglide:compile && svelte-kit sync && node scripts/run-development-service.mjs storybook",
		"build:storybook": "pnpm paraglide:compile && svelte-kit sync && storybook build"
	},
	"dependencies": {
		"@fontsource-variable/dynapuff": "^5.2.8",
		"@fontsource-variable/geist": "^5.2.9",
		"@sentry/cloudflare": "10.69.0",
		"@sentry/replay": "10.69.0",
		"@sentry/sveltekit": "^10.69.0",
		"aws4fetch": "^1.0.20",
		"better-auth": "~1.6.30",
		"drizzle-orm": "^0.45.2",
		"embla-carousel-svelte": "^8.6.0",
		"embla-carousel-wheel-gestures": "^8.1.0",
		"mode-watcher": "^1.1.0",
		"nanoid": "^5.1.16",
		"papaparse": "^5.5.3",
		"postgres": "^3.4.8",
		"resend": "^6.12.4",
		"svelte-sonner": "^1.1.1",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.1.1",
		"@cloudflare/workers-types": "^5.20260822.1",
		"@fontsource-variable/figtree": "^5.2.10",
		"@fontsource-variable/noto-sans": "^5.2.10",
		"@inlang/paraglide-js": "^2.24.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.17.0",
		"@playwright/test": "^1.58.2",
		"@standard-schema/spec": "^1.1.0",
		"@storybook/addon-a11y": "^10.3.3",
		"@storybook/addon-docs": "^10.3.3",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.3.3",
		"@storybook/svelte": "^10.3.3",
		"@storybook/sveltekit": "^10.3.3",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.5.0",
		"@types/papaparse": "^5.5.2",
		"@typescript-eslint/parser": "^8.57.2",
		"@vitest/browser-playwright": "~4.1.11",
		"@vitest/coverage-v8": "~4.1.11",
		"auth": "~1.6.30",
		"bits-ui": "2.17.2",
		"clsx": "^2.1.1",
		"devalue": "^5.9.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.1.0",
		"eslint-plugin-check-file": "^3.3.1",
		"eslint-plugin-storybook": "^10.3.3",
		"eslint-plugin-svelte": "^3.16.0",
		"fallow": "^2.48.4",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxlint": "^1.58.0",
		"playwright": "^1.58.2",
		"postcss-html": "^1.8.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"shadcn-svelte": "^1.2.7",
		"storybook": "^10.3.3",
		"stylelint": "^17.6.0",
		"stylelint-config-html": "^1.1.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.4.2",
		"svelte-eslint-parser": "^1.6.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.22.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.2",
		"vite": "^7.3.6",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "~4.1.11",
		"vitest-browser-svelte": "^2.1.0",
		"wrangler": "^4.125.0"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
